SUPABASE_URL=https://lgmdjkjwiimyqkmyfnlt.supabase.co

# Publishable ("anon") key. Jede Tool-Abfrage läuft über diesen Key plus das
# Access-Token des angemeldeten Nutzers — daran hängt die RLS und damit die
# Mandantentrennung.
SUPABASE_ANON_KEY=your_publishable_key_here

# Secret key (sb_secret_…) — umgeht RLS. Nur noch für get_caldav_accounts
# (Vault). Die alten Legacy-JWT-Keys sind seit 2026-07-18 deaktiviert.
SUPABASE_SERVICE_ROLE_KEY=your_secret_key_here

# Schlüssel, mit dem die OAuth-Tokens verschlüsselt und die Client-Metadaten
# signiert werden. Ein Wechsel macht alle bestehenden Verbindungen ungültig.
MCP_API_KEY=generate_a_strong_random_key_here

# For local dev only (Vercel sets VERCEL_URL automatically)
PORT=3000
